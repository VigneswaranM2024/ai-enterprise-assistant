# =============================================================================
# AI ENTERPRISE ASSISTANT — ENVIRONMENT VARIABLE TEMPLATE (.env.example)
# Copy this file to .env and fill in production secrets. Never commit .env!
# =============================================================================

# Server Port
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL Database Settings
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_enterprise_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SECURE_POSTGRES_PASSWORD_HERE

# Redis Cache Settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_SECURE_REDIS_PASSWORD_HERE
CACHE_REDIS_ENABLED=true

# Security & JWT Configuration
JWT_SECRET=YOUR_MIN_256_BIT_HS256_JWT_SECRET_STRING_HERE
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Groq LLM Configuration
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini Embeddings Configuration
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768

# API Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=30
