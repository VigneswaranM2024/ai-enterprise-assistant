# =============================================================================
# AI Enterprise Assistant — Environment Variables Template
# Copy this file to .env and fill in your actual values before running.
# NEVER commit the .env file to Git.
# =============================================================================

# Spring Profile (dev | prod)
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_assistant
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_db_password_here

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# JWT Security Secrets
# Must be at least 256 bits / 32 bytes (64 hex characters).
# Generate a secure random value: openssl rand -hex 32
JWT_SECRET=replace_with_a_strong_random_secret_at_least_64_chars
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Google Gemini API Key (for document embeddings)
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq LLM API Key (for AI chat and intent classification)
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
